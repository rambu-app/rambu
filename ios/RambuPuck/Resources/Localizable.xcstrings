    },
    "iOS menghentikan pemantauan panggilan.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "iOS stopped call monitoring." } } }
    },
    "Alamat server Rambu tidak valid.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The Rambu server address is invalid." } } }
    },
    "Skenario panggilan tidak tersedia.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The call scenario is unavailable." } } }
    },
    "Respons server Rambu tidak dapat dibaca.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The response from the Rambu server could not be read." } } }
    },
    "Server Rambu tidak dapat dihubungi.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The Rambu server could not be reached." } } }
    },
    "Respons jaringan Rambu tidak valid.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The response from the Rambu server is invalid." } } }
    },
    "Risiko rendah berisi bukti yang tidak valid.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The low-risk result contains invalid evidence." } } }
    },
    "Hasil berisiko tidak memiliki bukti.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The risk result does not include evidence." } } }
    },
    "Bukti analisis tidak sesuai transkrip.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The analysis evidence does not match the transcript." } } }
    },
    "Status sesi backend tidak dikenal.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The backend session status is unknown." } } }
    },
    "Sesi gagal tanpa keterangan.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The session failed without an explanation." } } }
    },
    "Tingkat risiko backend tidak dikenal.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The backend risk level is unknown." } } }
    },
    "Jenis tanda backend tidak dikenal.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The backend signal type is unknown." } } }
    },
    "Hubungkan akun orang tua sebelum memantau panggilan.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Connect the parent's account before monitoring calls." } } }
    },
    "Puck tidak ditemukan. Pastikan puck menyala dan dekat HP.": {
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Puck not found. Make sure it is turned on and near the phone." } } }
